# PostgreSQL
POSTGRES_USER=pii
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=pii_anonymizer
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg://pii:change_me_in_production@postgres:5432/pii_anonymizer
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,api,testserver
ENABLE_HSTS=false
DEBUG=false
MAX_TEXT_LENGTH=50000
SPACY_MODEL=en_core_web_sm

# Phase 4 — secure uploads (do not commit a real .env)
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=50
MAX_IMAGE_PIXELS=40000000
UPLOAD_TTL_MINUTES=60
UPLOAD_CLEANUP_INTERVAL_SECONDS=300
TEMP_UPLOAD_DIR=/var/pii-uploads

# Phase 6 — OCR (Tesseract; English only for MVP)
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_TIMEOUT_SECONDS=60
OCR_RENDER_DPI=200
OCR_MIN_WORD_CONFIDENCE=35
OCR_LOW_CONFIDENCE_THRESHOLD=60
OCR_MAX_PAGES=20
OCR_PREPROCESSING_ENABLED=true
OCR_DESKEW_ENABLED=true
OCR_TEMP_DIR=/var/pii-uploads/ocr-work
OCR_EXECUTABLE=tesseract

# Phase 8 — API / concurrency limits (per API process; not distributed rate limiting)
MAX_ENTITIES_PER_JOB=500
MAX_RECTANGLES_PER_ENTITY=32
MAX_MANUAL_RECTANGLES=100
MAX_CUSTOM_RECOGNIZERS=10
MAX_REGEX_PATTERN_LENGTH=200
MAX_AUDIT_WARNINGS=50
MAX_CONCURRENT_OCR_JOBS=2
MAX_CONCURRENT_DOCUMENT_JOBS=4
MAX_CONCURRENT_UPLOADS=4
MAX_CONCURRENT_REDACTIONS=2
CUSTOM_
MAX_REQUEST_ID_LENGTH=64
CONCURRENCY_RETRY_AFTER_SECONDS=5

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
